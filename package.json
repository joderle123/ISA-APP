{
  "name": "isa-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run index",
    "index": "tsx --tsconfig tsconfig.scripts.json scripts/toolbox-index.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "blaetter:pruefen": "tsx --tsconfig tsconfig.scripts.json scripts/blatt-pruefen.ts",
    "blaetter:render": "tsx --tsconfig tsconfig.scripts.json scripts/blatt-render.tsx",
    "blaetter:icons": "node scripts/blatt-icons.mjs",
    "blaetter:seiten": "tsx --tsconfig tsconfig.scripts.json scripts/blatt-seiten.tsx",
    "blaetter:mappe": "tsx --tsconfig tsconfig.scripts.json scripts/mappe-pruefen.tsx",
    "blaetter:modulheft": "tsx --tsconfig tsconfig.scripts.json scripts/modulheft.tsx",
    "blaetter:forscherkartei": "tsx --tsconfig tsconfig.scripts.json scripts/forscherkartei.tsx",
    "blaetter:lb": "tsx --tsconfig tsconfig.scripts.json scripts/lb-liste.ts",
    "kurs:pruefen": "tsx --tsconfig tsconfig.scripts.json scripts/kurs-pruefen.ts",
    "kurs:test": "node scripts/kurs-test.cjs",
    "foerderfach:pruefen": "tsx --tsconfig tsconfig.scripts.json scripts/foerderfach-pruefen.ts",
    "foerderfach:pdf": "tsx --tsconfig tsconfig.scripts.json scripts/foerderfach.tsx",
    "foerderfach:blatt": "tsx --tsconfig tsconfig.scripts.json scripts/foerderfach-blatt.tsx",
    "foerderfach:einheit": "tsx --tsconfig tsconfig.scripts.json scripts/foerderfach-einheit.tsx"
